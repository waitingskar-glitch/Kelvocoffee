# ---------------------------------------------------------------------------
# Kelvo storefront environment
# Copy to `.env` and fill in. Never commit `.env`.
# Every VITE_* value is embedded in the client bundle, so only ever put
# PUBLIC values here. The Shopify *Admin* API token must never appear.
# ---------------------------------------------------------------------------

# --- Shopify Storefront API ------------------------------------------------
# Your myshopify domain (not the custom domain).
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API access token. Shopify admin →
# Settings → Apps and sales channels → Develop apps → your app →
# Storefront API. Scopes needed: unauthenticated_read_product_listings,
# unauthenticated_read_product_inventory, unauthenticated_write_checkouts,
# unauthenticated_read_checkouts.
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. Defaults to 2025-07.
VITE_SHOPIFY_API_VERSION=2025-07

# Market context for pricing. Defaults to IN / EN.
VITE_SHOPIFY_COUNTRY_CODE=IN
VITE_SHOPIFY_LANGUAGE_CODE=EN

# --- Product handles -------------------------------------------------------
# Only set these if the handles in your Shopify admin differ from the defaults
# in src/config/shopify.ts.
VITE_HANDLE_CLASSIC=
VITE_HANDLE_VANILLA=
VITE_HANDLE_HAZELNUT=
VITE_HANDLE_CARAMEL=
VITE_HANDLE_WHISKEY=

# The Trial Pack does not exist in Shopify yet. Create the product, then put
# its handle here — the Trial Pack section switches from "Notify me" to a real
# Add to Cart, with price and stock read from Shopify.
VITE_HANDLE_TRIAL_PACK=

# --- Preorder / notify-me --------------------------------------------------
# Endpoint that receives interest submissions as JSON POST.
#
# To land signups in Shopify customer records, deploy
# `serverless/interest-to-shopify.ts` and paste its URL here. It keeps the
# Admin API token server-side, where it belongs.
#
# Formspree, Klaviyo, Brevo or a custom API work with the same payload.
# Leave blank in development: submissions are logged to the console instead.
VITE_PREORDER_ENDPOINT=

# --- Preorder disclosure ---------------------------------------------------
# When Shopify reports a variant as purchasable but out of stock ("continue
# selling when out of stock"), the site sells it as a clearly-labelled
# preorder, and this is the dispatch window shoppers are shown.
#
# It is dropped into the sentence "ships ___", so phrase it to follow that:
#   within 4 weeks of ordering     (rolling — never goes stale)
#   mid-November                   (fixed — converts better, must be met)
#
# Leave blank and the site says "we'll email your dispatch date" instead.
VITE_PREORDER_SHIP_ESTIMATE=within 4 weeks of ordering

# --- Site ------------------------------------------------------------------
VITE_SITE_URL=https://kelvocoffee.com
VITE_CONTACT_EMAIL=hello@kelvocoffee.com

# Social links. Only channels with a URL are rendered in the footer.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_WHATSAPP=
